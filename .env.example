DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/intellidocs
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
GROQ_API_KEY=replace-with-your-groq-api-key
PERSISTENT_DATA_DIR=data
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=10
RAG_DISTANCE_THRESHOLD=1.6
# Local speech-to-text model. "tiny" is fast and is downloaded by Whisper once.
WHISPER_MODEL=tiny
# Local Windows text-to-speech preferences. The app picks the first installed
# voice that matches these hints; Aria/Jenny are preferred when available.
TTS_VOICE_HINTS=aria,jenny,zira,hazel,david,mark
TTS_RATE=155
# Optional on Windows when Tesseract is not on PATH.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
